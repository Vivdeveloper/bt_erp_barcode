  "format_data": null,
  "html": "<style>\r\n    /* ======================================================\r\n       FORCE EXACT PAGE BOUNDARIES (LABEL ROLL SIZE)\r\n       ====================================================== */\r\n    html, body, .print-format, .print-format-container {\r\n        width: 100mm !important;\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n        background-color: #fff !important;\r\n    }\r\n    \r\n    * {\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box !important;\r\n    }\r\n\r\n    @media print {\r\n        @page {\r\n            size: 100mm 75mm; /* Map to TSC physical label size */\r\n            margin: 0 !important;\r\n        }\r\n        body {\r\n            width: 100mm !important;\r\n            height: auto !important; /* Continuous stream flow control */\r\n        }\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, sans-serif;\r\n    }\r\n\r\n    /* ======================================================\r\n       STICKER CONTAINER (TSC SAFE ZONE & CONTAINMENT)\r\n       ====================================================== */\r\n    .sticker {\r\n        width: 96mm !important;\r\n        height: 71mm !important;\r\n        margin: 2mm !important;\r\n        border: 1.5px solid #000 !important;\r\n        padding: 3mm 2mm !important;\r\n        overflow: hidden !important;   \r\n        position: relative;\r\n        background: #fff !important;\r\n        page-break-inside: avoid;      \r\n    }\r\n\r\n    /* Fixed: Page break ONLY between stickers, eliminating trailing blank pages */\r\n    .sticker:not(:last-child) {\r\n        page-break-after: always;\r\n    }\r\n\r\n    /* ======================================================\r\n       VRTV SPECIFIC CENTERED CONTENT LAYOUT\r\n       ====================================================== */\r\n    .vrtv-layout {\r\n        display: flex !important;\r\n        flex-direction: column;\r\n        align-items: center;\r\n        justify-content: center;\r\n        width: 100%;\r\n        height: 100%;\r\n        text-align: center;\r\n    }\r\n\r\n    .desc-label {\r\n        font-size: 10pt;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        margin-bottom: 0.5mm;\r\n    }\r\n\r\n    .desc-value {\r\n        font-size: 10pt;\r\n        font-weight: bold;\r\n        margin-bottom: 3mm;\r\n        max-width: 90mm;\r\n        word-break: break-word;\r\n        line-height: 1.2;\r\n    }\r\n\r\n    .barcode-block {\r\n        display: flex !important;\r\n        flex-direction: column;\r\n        align-items: center;\r\n        margin-bottom: 2.5mm;\r\n        width: 100%;\r\n    }\r\n\r\n    .barcode-block img {\r\n        width: 75mm;\r\n        max-height: 11mm;\r\n        object-fit: contain;\r\n    }\r\n\r\n    .barcode-text {\r\n        font-size: 10.5pt;\r\n        font-weight: bold;\r\n        margin-top: 0.5mm;\r\n        letter-spacing: 0.5px;\r\n    }\r\n</style>\r\n\r\n{# =======================================================\r\n   FILTER VALID BARCODES — serial_number with barcode fallback\r\n   + custom_selected_barcode_row support for single-row print\r\n   ======================================================= #}\r\n{% set valid_items = [] %}\r\n{% for row in doc.items %}\r\n    {% set sn = row.serial_number or row.barcode or \"\" %}\r\n    {% if sn|string|trim != \"\"\r\n        and \"{serial_number}\" not in sn %}\r\n\r\n        {% if (not doc.custom_selected_barcode_row)\r\n            or row.name == doc.custom_selected_barcode_row %}\r\n            {% set _ = valid_items.append(row) %}\r\n        {% endif %}\r\n\r\n    {% endif %}\r\n{% endfor %}\r\n\r\n{# =======================================================\r\n   RENDER STICKERS (ONE PER PAGE)\r\n   ======================================================= #}\r\n{% for row in valid_items %}\r\n\r\n{% set sn_value = row.serial_number or row.barcode or \"\" %}\r\n\r\n<div class=\"sticker\">\r\n    <div class=\"vrtv-layout\">\r\n        \r\n        <!-- Description Section -->\r\n        <div class=\"desc-label\">Description:</div>\r\n        <div class=\"desc-value\">\r\n            {{ row.description or row.item_name }}\r\n        </div>\r\n\r\n        <!-- Customer Ref Code Barcode Section -->\r\n        {% if row.customer_ref_code %}\r\n            <div class=\"barcode-block\">\r\n                <img src=\"https://bwipjs-api.metafloor.com/?bcid=code128&text={{ row.customer_ref_code }}&scale=2&height=10\"\r\n                     alt=\"Customer Ref Barcode\">\r\n                <div class=\"barcode-text\">\r\n                    {{ row.customer_ref_code }}\r\n                </div>\r\n            </div>\r\n        {% endif %}\r\n\r\n        <!-- Serial Number Barcode Section -->\r\n        <div class=\"barcode-block\" style=\"margin-bottom: 0;\">\r\n            <img src=\"https://bwipjs-api.metafloor.com/?bcid=code128&text={{ sn_value }}&scale=2&height=11\"\r\n                 alt=\"Serial Barcode\">\r\n            <div class=\"barcode-text\">\r\n                {{ sn_value }}\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n{% endfor %}",
