  "css": "/*@page {*/\n/*    size: 70mm 100mm;*/\n/*    margin: 0;*/\n/*}*/\n\n/*.label{*/\n/*    width:70mm;*/\n/*    height:100mm;*/\n/*}*/\n\n/*.box{*/\n/*    width:70mm;*/\n/*    height:100mm;*/\n/*    border:2px solid black;*/\n/*    box-sizing:border-box;*/\n/*    padding:4mm;*/\n\n/*    display: flex;*/\n/*    flex-direction: column;*/\n    justify-content: space-between;  /* ⭐ KEY FIX */\n/*}*/\n\n/* Header layout */\n/*.header{*/\n/*    display:flex;*/\n/*    align-items:center;*/\n/*    justify-content:center;*/\n/*    gap:4mm;*/\n/*    margin-bottom: 2mm;*/\n/*}*/\n\n/* CE mark */\n/*.ce{*/\n/*    font-weight:bold;*/\n/*    font-size:16px;*/\n/*}*/\n\n/* Logo control */\n/*.logo{*/\n/*    max-height:8mm;*/\n/*    max-width:35mm;*/\n/*    object-fit:contain;*/\n/*}*/\n\n/* Address */\n/*.address{*/\n/*    text-align:center;*/\n/*    font-size:8px;*/\n/*    margin-top: 1mm;*/\n/*}*/\n\n/*.website{*/\n/*    text-align:center;*/\n/*    font-size:8px;*/\n/*    margin-bottom:3mm;*/\n/*}*/\n\n/*.barcode-text{*/\n/*    text-align:center;*/\n/*    font-weight:bold;*/\n/*    font-size:12px;*/\n/*    margin-top:4mm;*/\n/*}*/\n\n/*.page-break{*/\n/*    page-break-before:always;*/\n/*}*/",
