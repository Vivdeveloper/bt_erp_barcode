  "html": "<style>\r\n    * {\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    @media print {\r\n        @page {\r\n            size: 100mm 75mm;\r\n            margin: 1.5mm;\r\n        }\r\n\r\n        body {\r\n            margin: 0;\r\n        }\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, sans-serif;\r\n    }\r\n\r\n    .sticker {\r\n        width: 97mm;\r\n        height: 72mm;\r\n        border: 1px solid #000;\r\n        padding: 2mm;\r\n        page-break-after: always;\r\n        overflow: hidden;\r\n    }\r\n\r\n    /* =========================\r\n       HEADER\r\n       ========================= */\r\n\r\n    .header {\r\n        display: flex;\r\n        align-items: center;\r\n        border-bottom: 1px solid #000;\r\n        padding-bottom: 1mm;\r\n        margin-bottom: 1mm;\r\n    }\r\n\r\n    .ce-mark {\r\n        flex: 0 0 auto;\r\n        width: 14mm;\r\n    }\r\n\r\n    .header-right {\r\n        flex: 1;\r\n        text-align: center;\r\n    }\r\n\r\n    .logo {\r\n        width: 42mm;\r\n        margin-bottom: 0.5mm;\r\n    }\r\n\r\n    .company-address {\r\n        font-size: 5pt;\r\n        line-height: 1.1;\r\n    }\r\n\r\n    /* =========================\r\n       BARCODE LABEL\r\n       ========================= */\r\n\r\n    .barcode-label {\r\n        font-size: 5pt;\r\n        text-align: center;\r\n        color: #555;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n        margin-top: 1mm;\r\n        margin-bottom: 0.5mm;\r\n    }\r\n\r\n    /* =========================\r\n       BARCODE\r\n       ========================= */\r\n\r\n    .barcode-wrapper {\r\n        text-align: center;\r\n        margin: 0.5mm 0;\r\n    }\r\n\r\n    .barcode-wrapper img {\r\n        width: 74mm;\r\n        height: 8mm;\r\n    }\r\n\r\n    .barcode-number {\r\n        font-size: 9pt;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        letter-spacing: 1px;\r\n        margin-bottom: 1mm;\r\n        word-break: break-all;\r\n        line-height: 1;\r\n    }\r\n\r\n    .barcode-empty {\r\n        text-align: center;\r\n        border: 1px dashed #aaa;\r\n        padding: 2mm;\r\n        font-size: 6pt;\r\n        color: #999;\r\n        margin: 1mm 4mm;\r\n    }\r\n\r\n    /* =========================\r\n       DIVIDER\r\n       ========================= */\r\n\r\n    .barcode-divider {\r\n        border-top: 1px dashed #ccc;\r\n        margin: 1mm 0;\r\n    }\r\n\r\n    /* =========================\r\n       INFO\r\n       ========================= */\r\n\r\n    .info {\r\n        border-top: 1px solid #000;\r\n        padding-top: 1mm;\r\n        font-size: 6pt;\r\n        margin-top: 1mm;\r\n    }\r\n\r\n    .info-row {\r\n        display: flex;\r\n        margin-bottom: 0.8mm;\r\n        line-height: 1.1;\r\n    }\r\n\r\n    .info-label {\r\n        font-weight: bold;\r\n        min-width: 16mm;\r\n    }\r\n\r\n    .info-value {\r\n        flex: 1;\r\n        word-break: break-word;\r\n    }\r\n\r\n    /* =========================\r\n       FOOTER\r\n       ========================= */\r\n\r\n    .footer {\r\n        text-align: center;\r\n        font-size: 5pt;\r\n        margin-top: 1mm;\r\n        border-top: 1px solid #000;\r\n        padding-top: 0.8mm;\r\n        line-height: 1.1;\r\n    }\r\n</style>\r\n\r\n{# =========================================\r\n   FILTER ONLY VALID GENERATED BARCODES\r\n   ========================================= #}\r\n\r\n{% set valid_items = [] %}\r\n\r\n{% for row in doc.items %}\r\n\r\n    {% if row.barcode\r\n        and row.barcode|string|trim != \"\"\r\n        and \"{serial_number}\" not in row.barcode %}\r\n\r\n        {% set _ = valid_items.append(row) %}\r\n\r\n    {% endif %}\r\n\r\n{% endfor %}\r\n\r\n{# =========================================\r\n   PRINT VALID BARCODES\r\n   ========================================= #}\r\n\r\n{% for row in valid_items %}\r\n\r\n{% set ip_class = frappe.db.get_value(\"Production Plan\", doc.production_plan, \"custom_ip_class\") or \"\" %}\r\n\r\n<div class=\"sticker\">\r\n\r\n    <!-- HEADER -->\r\n\r\n    <div class=\"header\">\r\n\r\n        <div class=\"ce-mark\">\r\n\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\"\r\n                 width=\"34\"\r\n                 height=\"24\"\r\n                 viewBox=\"0 0 280 200\">\r\n\r\n                <path d=\"M100,0 C44.77,0 0,44.77 0,100\r\n                         C0,155.23 44.77,200 100,200\r\n                         L100,160\r\n                         C66.86,160 40,133.14 40,100\r\n                         C40,66.86 66.86,40 100,40\r\n                         L100,0 Z\"\r\n                      fill=\"#000000\"/>\r\n\r\n                <path d=\"M240,0 C184.77,0 140,44.77 140,100\r\n                         C140,155.23 184.77,200 240,200\r\n                         L240,160\r\n                         C206.86,160 180,133.14 180,100\r\n                         C180,66.86 206.86,40 240,40\r\n                         L240,0 Z\r\n\r\n                         M180,80\r\n                         L240,80\r\n                         L240,120\r\n                         L180,120\r\n                         L180,80 Z\"\r\n                      fill=\"#000000\"/>\r\n\r\n            </svg>\r\n\r\n        </div>\r\n\r\n        <div class=\"header-right\">\r\n\r\n            <img src=\"/files/Bartakke logo.png\"\r\n                 alt=\"Bartakke\"\r\n                 class=\"logo\">\r\n\r\n            <div class=\"company-address\">\r\n                L-20, Addl. MIDC, Satara-415004, Maharashtra, INDIA<br>\r\n                www.bartakke.co.in\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- CUSTOMER REF CODE -->\r\n\r\n    <div class=\"barcode-label\">\r\n        CUSTOMER REF CODE\r\n    </div>\r\n\r\n    {% if row.customer_ref_code %}\r\n\r\n        <div class=\"barcode-wrapper\">\r\n\r\n            <img src=\"https://bwipjs-api.metafloor.com/?bcid=code128&text={{ row.customer_ref_code }}&scale=2&height=8\"\r\n                 alt=\"Customer Ref Barcode\">\r\n\r\n        </div>\r\n\r\n        <div class=\"barcode-number\">\r\n            {{ row.customer_ref_code }}\r\n        </div>\r\n\r\n    {% else %}\r\n\r\n        <div class=\"barcode-empty\">\r\n            NOT ASSIGNED\r\n        </div>\r\n\r\n    {% endif %}\r\n\r\n    <div class=\"barcode-divider\"></div>\r\n\r\n    <!-- SERIAL NUMBER -->\r\n\r\n    <div class=\"barcode-label\">\r\n        SERIAL NUMBER\r\n    </div>\r\n\r\n    {% if row.barcode %}\r\n\r\n        <div class=\"barcode-wrapper\">\r\n\r\n            <img src=\"https://bwipjs-api.metafloor.com/?bcid=code128&text={{ row.barcode }}&scale=2&height=8\"\r\n                 alt=\"Serial Barcode\">\r\n\r\n        </div>\r\n\r\n        <div class=\"barcode-number\">\r\n            {{ row.barcode }}\r\n        </div>\r\n\r\n    {% else %}\r\n\r\n        <div class=\"barcode-empty\">\r\n            NOT ASSIGNED\r\n        </div>\r\n\r\n    {% endif %}\r\n\r\n    <!-- INFO -->\r\n\r\n    <div class=\"info\">\r\n\r\n        <div class=\"info-row\">\r\n\r\n            <span class=\"info-label\">\r\n                Panel:\r\n            </span>\r\n\r\n            <span class=\"info-value\">\r\n\r\n                {% set dimensions = row.item_name.split(')') %}\r\n\r\n                {{ dimensions[-1].strip()\r\n                   if dimensions|length > 1\r\n                   else row.item_name }}\r\n\r\n            </span>\r\n\r\n        </div>\r\n\r\n        <div class=\"info-row\">\r\n\r\n            <span class=\"info-label\">\r\n                IP:\r\n            </span>\r\n\r\n            <span class=\"info-value\">\r\n                {{ ip_class }}\r\n            </span>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- FOOTER -->\r\n\r\n    <div class=\"footer\">\r\n        In Compliance with IEC 61439/62208\r\n    </div>\r\n\r\n</div>\r\n\r\n{% endfor %}",
