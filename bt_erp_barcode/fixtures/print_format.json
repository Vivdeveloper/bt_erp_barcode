  "html": "<style>\r\n    /* ======================================================\r\n       FORCE EXACT PAGE BOUNDARIES (LABEL ROLL SIZE)\r\n       ====================================================== */\r\n    html, body, .print-format, .print-format-container {\r\n        width: 100mm !important;\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n        background-color: #fff !important;\r\n    }\r\n    \r\n    * {\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box !important;\r\n    }\r\n\r\n    @media print {\r\n        @page {\r\n            size: 100mm 75mm; /* Tells the TSC driver the physical label size */\r\n            margin: 0 !important;\r\n        }\r\n        body {\r\n            width: 100mm !important;\r\n            height: auto !important; /* Fixed: Allows body to flow dynamically across multi-label outputs */\r\n        }\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, sans-serif;\r\n    }\r\n\r\n    /* ======================================================\r\n       STICKER CONTAINER (TSC TE244 SAFE ZONE)\r\n       ====================================================== */\r\n    .sticker {\r\n        width: 96mm !important;\r\n        height: 71mm !important;\r\n        margin: 2mm !important;\r\n        border: 1.5px solid #000 !important;\r\n        padding: 2mm !important;\r\n        overflow: hidden !important;   \r\n        position: relative;\r\n        background: #fff !important;\r\n        page-break-inside: avoid;      \r\n    }\r\n\r\n    /* Fixed: Only insert page breaks between multiple stickers, preventing trailing blank pages */\r\n    .sticker:not(:last-child) {\r\n        page-break-after: always;\r\n    }\r\n\r\n    /* ======================================================\r\n       HEADER SECTION\r\n       ====================================================== */\r\n    .header {\r\n        display: flex !important;\r\n        align-items: center;\r\n        justify-content: space-between;\r\n        border-bottom: 1px solid #000;\r\n        padding-bottom: 1.5mm;\r\n        margin-bottom: 1.5mm;\r\n        gap: 2mm;\r\n    }\r\n\r\n    .ce-mark {\r\n        width: 10mm;\r\n        display: flex !important;\r\n        align-items: center;\r\n        justify-content: center;\r\n        flex-shrink: 0;\r\n    }\r\n\r\n    .header-right {\r\n        flex: 1;\r\n        display: flex !important;\r\n        flex-direction: column;\r\n        align-items: center;\r\n        justify-content: center;\r\n    }\r\n\r\n    .logo-wrapper {\r\n        width: 100%;\r\n        display: flex !important;\r\n        justify-content: center;\r\n        align-items: center;\r\n    }\r\n\r\n    .logo-wrapper img {\r\n        width: 42mm; \r\n        height: auto;\r\n        display: block;\r\n    }\r\n\r\n    .company-address {\r\n        margin-top: 0.5mm;\r\n        text-align: center;\r\n        font-size: 5.5pt;\r\n        line-height: 1.2;\r\n    }\r\n\r\n    /* ======================================================\r\n       LABELS & BARCODE SECTION\r\n       ====================================================== */\r\n    .barcode-label {\r\n        font-size: 6pt;\r\n        text-align: center;\r\n        color: #000;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n        margin-top: 0.5mm;\r\n        margin-bottom: 0.5mm;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .barcode-wrapper {\r\n        text-align: center;\r\n        margin: 0.5mm 0;\r\n    }\r\n\r\n    .barcode-wrapper img {\r\n        width: 65mm; \r\n        max-height: 8mm;\r\n        object-fit: contain;\r\n    }\r\n\r\n    .barcode-number {\r\n        font-size: 9.5pt;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        margin-bottom: 1mm;\r\n        letter-spacing: 1px;\r\n    }\r\n\r\n    /* ======================================================\r\n       INFO SECTION (CLEAN ALIGNMENT)\r\n       ====================================================== */\r\n    .info {\r\n        border-top: 1px solid #000;\r\n        padding-top: 1.5mm;\r\n        font-size: 7pt;\r\n    }\r\n\r\n    .info-row {\r\n        margin-bottom: 1mm;\r\n        display: flex !important;\r\n    }\r\n\r\n    .info-label {\r\n        font-weight: bold;\r\n        width: 16mm;\r\n        flex-shrink: 0;\r\n    }\r\n\r\n    .info-row span:last-child {\r\n        flex: 1;\r\n        word-break: break-word;\r\n    }\r\n\r\n    /* ======================================================\r\n       FOOTER SECTION\r\n       ====================================================== */\r\n    .footer {\r\n        text-align: center;\r\n        font-size: 6pt;\r\n        border-top: 1px solid #000;\r\n        padding-top: 1mm;\r\n        position: absolute;\r\n        bottom: 1.5mm;\r\n        left: 1.5mm;\r\n        width: calc(100% - 3mm);\r\n    }\r\n</style>\r\n\r\n{# ======================================================= #}\r\n{# FILTER VALID BARCODES — use serial_number, fallback to barcode #}\r\n{# ======================================================= #}\r\n\r\n{% set valid_items = [] %}\r\n\r\n{% for row in doc.items %}\r\n    {% set sn = row.serial_number or row.barcode or \"\" %}\r\n\r\n    {% if sn|string|trim != \"\"\r\n        and \"{serial_number}\" not in sn %}\r\n\r\n        {% if (not doc.custom_selected_barcode_row)\r\n            or row.name == doc.custom_selected_barcode_row %}\r\n            {% set _ = valid_items.append(row) %}\r\n        {% endif %}\r\n\r\n    {% endif %}\r\n{% endfor %}\r\n{# =======================================================\r\n   ONE BARCODE = ONE PAGE\r\n   ======================================================= #}\r\n\r\n{% for row in valid_items %}\r\n\r\n\r\n{% set ip_class = frappe.db.get_value(\r\n    \"Production Plan\",\r\n    doc.production_plan,\r\n    \"custom_ip_class\"\r\n) or \"\" %}\r\n\r\n<div class=\"sticker\">\r\n\r\n    <!-- ===================================================\r\n         HEADER\r\n         =================================================== -->\r\n    <div class=\"header\">\r\n        <div class=\"ce-mark\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\"\r\n                 width=\"32\"\r\n                 height=\"22\"\r\n                 viewBox=\"0 0 280 200\">\r\n                <path d=\"M100,0 C44.77,0 0,44.77 0,100\r\n                         C0,155.23 44.77,200 100,200\r\n                         L100,160\r\n                         C66.86,160 40,133.14 40,100\r\n                         C40,66.86 66.86,40 100,40\r\n                         L100,0 Z\"\r\n                      fill=\"#000000\"/>\r\n                <path d=\"M240,0 C184.77,0 140,44.77 140,100\r\n                         C140,155.23 184.77,200 240,200\r\n                         L240,160\r\n                         C206.86,160 180,133.14 180,100\r\n                         C180,66.86 206.86,40 240,40\r\n                         L240,0 Z\r\n                         M180,80\r\n                         L240,80\r\n                         L240,120\r\n                         L180,120\r\n                         L180,80 Z\"\r\n                      fill=\"#000000\"/>\r\n            </svg>\r\n        </div>\r\n\r\n        <div class=\"header-right\">\r\n            <div class=\"logo-wrapper\">\r\n                <img src=\"/files/Bartakke logo.png\" alt=\"Bartakke\">\r\n            </div>\r\n            <div class=\"company-address\">\r\n                L-20, Addl. MIDC, Satara-415004, Maharashtra, INDIA<br>\r\n                www.bartakke.co.in | bepl@bartakke.co.in\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         CUSTOMER REF CODE\r\n         =================================================== -->\r\n    <div class=\"barcode-label\">\r\n        CUSTOMER REF CODE\r\n    </div>\r\n\r\n    {% if row.customer_ref_code %}\r\n        <div class=\"barcode-wrapper\">\r\n            <img src=\"https://bwipjs-api.metafloor.com/?bcid=code128&text={{ row.customer_ref_code }}&scale=2&height=8\"\r\n                 alt=\"Customer Ref Barcode\">\r\n        </div>\r\n        <div class=\"barcode-number\">\r\n            {{ row.customer_ref_code }}\r\n        </div>\r\n    {% else %}\r\n        <div class=\"barcode-empty\">\r\n            <br>\r\n        </div>\r\n    {% endif %}\r\n\r\n    <div class=\"barcode-divider\"></div>\r\n\r\n    <!-- ===================================================\r\n     SERIAL NUMBER\r\n     =================================================== -->\r\n<div class=\"barcode-label\">\r\n    SERIAL NUMBER\r\n</div>\r\n\r\n{% set sn_value = row.serial_number or row.barcode or \"\" %}\r\n\r\n{% if sn_value %}\r\n    <div class=\"barcode-wrapper\">\r\n        <img src=\"https://bwipjs-api.metafloor.com/?bcid=code128&text={{ sn_value }}&scale=2&height=8\"\r\n             alt=\"Serial Barcode\">\r\n    </div>\r\n    <div class=\"barcode-number\">\r\n        {{ sn_value }}\r\n    </div>\r\n{% else %}\r\n    <div class=\"barcode-empty\">\r\n        NOT ASSIGNED\r\n    </div>\r\n{% endif %}\r\n    <!-- ===================================================\r\n         INFO SECTION\r\n         =================================================== -->\r\n    <div class=\"info\">\r\n        <div class=\"info-row\">\r\n            <span class=\"info-label\">\r\n                Panel Size:\r\n            </span>\r\n            <span>\r\n                {% set parts = row.item_name.split('(IEC STD)') %}\r\n                {{ parts[1].strip() if parts|length > 1 else row.item_name }}\r\n            </span>\r\n        </div>\r\n\r\n        <!-- Fixed: Fetching IP Class from Production Plan using doc.production_plan -->\r\n        <div class=\"info-row\">\r\n    <span class=\"info-label\">IP Class:</span>\r\n    <span>\r\n        {% set ip_class = '' %}\r\n        {% set ref_name = '' %}\r\n        \r\n        {# Step 1: Extract the reference ID (could be a Work Order or Production Plan) #}\r\n        {% if doc.get(\"production_plans\") and doc.get(\"production_plans\")|length > 0 %}\r\n            {% set ref_name = doc.get(\"production_plans\")[0].work_order %}\r\n        {% endif %}\r\n        \r\n        {% if not ref_name and doc.get(\"production_plan\") %}\r\n            {% set ref_name = doc.get(\"production_plan\").split(',')[0].strip() %}\r\n        {% endif %}\r\n\r\n        {# Step 2: Safely check and fetch from Work Order if it exists there #}\r\n        {% if ref_name and frappe.db.exists(\"Work Order\", ref_name) %}\r\n            {% set ref_doc = frappe.get_doc(\"Work Order\", ref_name) %}\r\n            {% if ref_doc %}\r\n                {% set ip_class = ref_doc.get(\"custom_ip_class\") or ref_doc.get(\"ip_class\") or ref_doc.get(\"custom_ip\") or '' %}\r\n            {% endif %}\r\n        {% endif %}\r\n\r\n        {# Step 3: If not found above, safely check and fetch from Production Plan instead #}\r\n        {% if not ip_class and ref_name and frappe.db.exists(\"Production Plan\", ref_name) %}\r\n            {% set ref_doc = frappe.get_doc(\"Production Plan\", ref_name) %}\r\n            {% if ref_doc %}\r\n                {% set ip_class = ref_doc.get(\"custom_ip_class\") or ref_doc.get(\"ip_class\") or ref_doc.get(\"custom_ip\") or '' %}\r\n            {% endif %}\r\n        {% endif %}\r\n\r\n        {{ ip_class or '' }}\r\n    </span>\r\n</div>\r\n</div>\r\n\r\n    <!-- ===================================================\r\n         FOOTER\r\n         =================================================== -->\r\n    <div class=\"footer\">\r\n        In Compliance with IEC 61439/62208\r\n    </div>\r\n\r\n</div>\r\n\r\n{% endfor %}",
